# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ambiance?retryWrites=true&w=majority

# Port du serveur Express
PORT=3000

# JWT Secret pour l'authentification utilisateur
JWT_SECRET=ambiance-secret-dev

# --- Bridge Phyphox (npm run bridge) ---
PHYPHOX_HOST=http://192.168.x.x:8080
BRIDGE_API_KEY=
API_URL=http://localhost:3000
BRIDGE_LOCATION=cafe-olimpico
BRIDGE_INTERVAL=5

# Origines autorisées, séparées par des virgules
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,https://sonomap.onrender.com